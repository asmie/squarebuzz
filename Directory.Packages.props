<Project>

  <!-- Central Package Management: versions live here only, never in the .csproj files. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="App">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />

    <!-- Short sound effects through each platform's audio player. -->
    <PackageVersion Include="Plugin.Maui.Audio" Version="4.0.0" />
  </ItemGroup>

  <!--
    sqlite-net-pcl includes SQLitePCLRaw and SourceGear.sqlite3. Adding bundle_green would
    duplicate the native Android library and reintroduce its older SQLite dependency.
  -->
  <ItemGroup Label="Data">
    <PackageVersion Include="sqlite-net-pcl" Version="1.11.285" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- Keep the host profiling controls aligned with the app's Controls package. -->
    <PackageVersion Include="Microsoft.Maui.Controls.Core" Version="10.0.110"
                    Condition="'$(MSBuildProjectName)' == 'Squarebuzz.Profiling'" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.analyzers" Version="2.1.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
