<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Squarebuzz.Profiling</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Stable optimized host code; mobile Mono/AOT timings still require a device. -->
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation" Value="false" />
    <ProjectReference Include="../../src/Squarebuzz.Presentation/Squarebuzz.Presentation.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls.Core" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.ApplicationModel" />
    <Using Include="Microsoft.Maui.Graphics" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exercise production code, without platform handlers or pretending to render pixels. -->
    <Compile Include="../../src/Squarebuzz.App/Controls/BoardView.cs" Link="App/BoardView.cs" />
    <Compile Include="../../src/Squarebuzz.App/Controls/BoardMiniMapView.cs" Link="App/BoardMiniMapView.cs" />
    <Compile Include="../../src/Squarebuzz.App/Controls/MagnifierView.cs" Link="App/MagnifierView.cs" />
    <Compile Include="../../src/Squarebuzz.App/Drawing/BoardDrawable.cs" Link="App/BoardDrawable.cs" />
    <Compile Include="../../src/Squarebuzz.App/Drawing/BoardPalette.cs" Link="App/BoardPalette.cs" />
    <Compile Include="../../src/Squarebuzz.App/Drawing/MagnifierDrawable.cs" Link="App/MagnifierDrawable.cs" />
    <Compile Include="../../src/Squarebuzz.App/Services/MotionPreferences.cs" Link="App/MotionPreferences.cs" />
    <Compile Include="../../src/Squarebuzz.App/Services/LocalizationService.cs" Link="App/LocalizationService.cs" />
    <EmbeddedResource Include="../../src/Squarebuzz.App/Resources/Strings/AppStrings.resx"
                      LogicalName="Squarebuzz.App.Resources.Strings.AppStrings.resources" />
    <Compile Include="../../tests/Squarebuzz.Presentation.Tests/Fakes/FakeServices.cs" Link="Fakes/FakeServices.cs" />
    <Compile Include="../../tests/Squarebuzz.Presentation.Tests/Fakes/FakeRepositories.cs" Link="Fakes/FakeRepositories.cs" />
    <Compile Include="../../tests/Squarebuzz.Presentation.Tests/Fakes/FakePersistenceDiagnostics.cs" Link="Fakes/FakePersistenceDiagnostics.cs" />
  </ItemGroup>
</Project>
