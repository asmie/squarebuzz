<Project>

  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Must stay false. squarebuzz ships in English, Polish and Spanish, and invariant
      globalization makes CultureInfo.GetCultureInfo("pl") throw CultureNotFoundException -
      which surfaces as a TypeInitializationException the first time anything touches
      LocalizationService. The ICU data it pulls in is the price of being localised.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Warnings are defects. Kept on for Core/Data; the MAUI head relaxes this below. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <Product>squarebuzz</Product>
    <Company>squarebuzz</Company>
    <Copyright>Copyright © squarebuzz</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
