<Project>

  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep culture-specific formatting and resource lookup available for all supported languages. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Treat analyser warnings as errors. The MAUI project relaxes this for generated code. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <Product>squarebuzz</Product>
    <Company>squarebuzz</Company>
    <Copyright>Copyright © squarebuzz</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
