# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/

# Visual Studio / Rider / VS Code
.vs/
.idea/
*.user
*.suo
*.userprefs
*.sln.docstates

# MAUI / mobile build artefacts
# NOTE: do not add a bare "*.app/" here - it matches the Squarebuzz.App project directory
# and silently excludes the entire MAUI head from the repository. macOS .app bundles and
# .dSYM folders only ever appear under bin/obj, which are already ignored above.
*.apk
*.aab
*.ipa
*.binlog
Platforms/Android/**/keystore.properties
*.keystore
*.jks
*.mobileprovision
*.p12

# NuGet
*.nupkg
packages/
.nuget/

# Node (design/ prototype tooling)
node_modules/

# Test / coverage output
[Tt]est[Rr]esult*/
coverage*/
*.trx

# OS noise
Thumbs.db
desktop.ini
.DS_Store
