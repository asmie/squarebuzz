<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Non-colour design tokens and base control styles.
  Colours live in Resources/Themes/*.xaml and are swapped at runtime by ThemeService,
  so everything here refers to them only through DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Type scale. The prototype grows these at 760px / 1100px via media queries;
         MAUI has no media queries, so tablets get the larger step via OnIdiom. -->
    <OnIdiom x:Key="FontSizeBody" x:TypeArguments="x:Double" Phone="18" Tablet="19" Desktop="19" Default="18" />
    <OnIdiom x:Key="FontSizeH1" x:TypeArguments="x:Double" Phone="28" Tablet="34" Desktop="40" Default="28" />
    <OnIdiom x:Key="FontSizeH2" x:TypeArguments="x:Double" Phone="21" Tablet="24" Desktop="24" Default="21" />
    <OnIdiom x:Key="FontSizeLabel" x:TypeArguments="x:Double" Phone="16" Tablet="17" Desktop="17" Default="16" />

    <!-- Layout padding (the prototype's "pad") and its 430/720/980 frame cap. -->
    <OnIdiom x:Key="PagePadding" x:TypeArguments="Thickness" Phone="18" Tablet="26" Desktop="34" Default="18" />
    <OnIdiom x:Key="FrameMaxWidth" x:TypeArguments="x:Double" Phone="430" Tablet="720" Desktop="980" Default="430" />

    <!-- Minimum 48px touch targets throughout: this is a game for 6-12 year olds. -->
    <x:Double x:Key="TouchTargetMin">48</x:Double>

    <!--
      The focus glow's colour. A static resource on purpose: a Shadow brush inside a visual
      state cannot re-resolve DynamicResource, and the sky blue reads on every theme.
    -->
    <SolidColorBrush x:Key="FocusRing" Color="#4FA8F5" />

    <Style x:Key="BasePage" TargetType="Page">
        <Setter Property="BackgroundColor" Value="{DynamicResource Bg}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Page" BasedOn="{StaticResource BasePage}" ApplyToDerivedTypes="True" />
    <!-- MAUI 10 pages default to edge-to-edge. Keep scroll-only pages out of system bars,
         and keep parent-gate entries and buttons above the on-screen keyboard. -->
    <Style TargetType="ContentPage" BasedOn="{StaticResource BasePage}" ApplyToDerivedTypes="True">
        <Setter Property="SafeAreaEdges" Value="All" />
    </Style>

    <!--
      Fredoka for display, Quicksand for everything else, as the design specifies. Where a style
      already says FontFamily="BodyBold" the family is the bold cut rather than a synthetic
      thickening of the medium one - a rounded face smears badly when the platform fakes weight.
    -->

    <!--
      Which family headings use. A resource rather than a literal because Fredoka cannot render
      every language the game ships in, and a heading with one substituted letter in it looks
      broken - AppShell swaps this to the body face for those languages. See AppLanguages.All.
    -->
    <x:String x:Key="DisplayFontFamily">Display</x:String>
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="Body" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeH1}" />
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeH2}" />
    </Style>

    <Style x:Key="Subtle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Ink2}" />
        <Setter Property="FontFamily" Value="Body" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
    </Style>

    <!--
      The pressable face from the design system: a solid shadow along the bottom edge that the
      button sinks into when pressed, so it reads as a physical key rather than a flat rectangle.
      Focus swaps the shadow for a sky glow - the design's focus ring - which matters for
      keyboard players on desktop and never replaces the border, because there is none.
    -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontFamily" Value="BodyBold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Shadow">
            <Shadow Brush="#40000000" Radius="0" Offset="0,3" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="TranslationY" Value="0" />
                            <Setter Property="Shadow">
                                <Shadow Brush="#40000000" Radius="0" Offset="0,3" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="TranslationY" Value="2" />
                            <Setter Property="Shadow">
                                <Shadow Brush="#40000000" Radius="0" Offset="0,1" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="Shadow">
                                <Shadow Brush="{StaticResource FocusRing}" Radius="8" Offset="0,0" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <!--
                      Without this a disabled button looked exactly like an enabled one: the
                      explicit background overrides the platform's own greyed-out look. The same state
                      is on SecondaryButton: the hint button with hints switched off, and undo
                      with nothing to undo, read as broken rather than unavailable.
                    -->
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="TranslationY" Value="0" />
                            <Setter Property="Shadow">
                                <Shadow Brush="Transparent" Radius="0" Offset="0,0" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface2}" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontFamily" Value="BodyBold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Shadow">
            <Shadow Brush="#26000000" Radius="0" Offset="0,3" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="TranslationY" Value="0" />
                            <Setter Property="Shadow">
                                <Shadow Brush="#26000000" Radius="0" Offset="0,3" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="TranslationY" Value="2" />
                            <Setter Property="Shadow">
                                <Shadow Brush="#26000000" Radius="0" Offset="0,1" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="Shadow">
                                <Shadow Brush="{StaticResource FocusRing}" Radius="8" Offset="0,0" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="TranslationY" Value="0" />
                            <Setter Property="Shadow">
                                <Shadow Brush="Transparent" Radius="0" Offset="0,0" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--
      Flat faces, for buttons that lie on a card or among chips rather than standing up as keys.
      There is no bottom shadow, so nothing to sink into on press, but they take the same focus
      glow and disabled fade as the pressable buttons above. Not used directly: see the styles
      based on it below.
    -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="FontFamily" Value="BodyBold" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <!-- Normal and Pressed are the resting face; they exist to clear the glow. -->
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="Shadow">
                                <Shadow Brush="{StaticResource FocusRing}" Radius="8" Offset="0,0" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- A transparent button whose card, or the page, is its face: menu and About links, Skip. -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <!--
      One option of a segmented choice. Selection colours are bound per button (a BoolSelect
      converter over that option's flag), so only the shape lives here.
    -->
    <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Destructive actions: quit, reset. The confirming step overrides to the stronger Warn. -->
    <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="BackgroundColor" Value="{DynamicResource WarnSoft}" />
        <Setter Property="TextColor" Value="{DynamicResource OnWarnSoft}" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!--
      A selectable chip. Its background and the selected state's hidden outline are bound in each
      item template, where the item's type is known to the compiled bindings.
    -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource Line}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="16" />
        </Setter>
    </Style>

    <Style TargetType="Switch">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="OnColor" Value="{DynamicResource Accent}" />
        <!--
          A fixed light knob, not the Surface colour: in the dark themes Surface is the card behind
          the switch, and the knob vanished into it.
        -->
        <Setter Property="ThumbColor" Value="#FFFFFF" />
    </Style>

    <!-- Card surface: the prototype's surface colour with a 2px line-coloured border. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Stroke" Value="{DynamicResource Line}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="22" />
        </Setter>
    </Style>

</ResourceDictionary>
