<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Trio accent: orange primary, violet accent. From [data-accent="trio"].
  The prototype defines no dark variant, so these values apply in every theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Squarebuzz.App.Resources.Themes.Accents.Trio">

    <Color x:Key="Primary">#FF8A3D</Color>
    <Color x:Key="PrimaryDeep">#D3641F</Color>

    <Color x:Key="Accent">#6F3DE0</Color>
    <Color x:Key="AccentDeep">#5326B4</Color>
    <Color x:Key="OnAccent">#FFFFFF</Color>

</ResourceDictionary>
