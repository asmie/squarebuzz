<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Light theme. Ported 1:1 from the `:root` block of design/Squarebuzz.dc.html.
  Keys keep the prototype's semantic names so the two can be diffed by eye.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Squarebuzz.App.Resources.Themes.Light">

    <Color x:Key="Bg">#FFF6EA</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Surface2">#FFF0DC</Color>
    <Color x:Key="Sunk">#F6E7D0</Color>

    <Color x:Key="Ink">#332E42</Color>
    <Color x:Key="Ink2">#5F5770</Color>
    <Color x:Key="Line">#EADFCC</Color>

    <Color x:Key="CellEmpty">#FFFDF7</Color>
    <Color x:Key="CellLine">#E4D8C4</Color>
    <Color x:Key="CellFill">#3B3550</Color>
    <Color x:Key="CellFill2">#514A6B</Color>

    <Color x:Key="Gutter">#FBEEDA</Color>
    <Color x:Key="GutterInk">#5B5268</Color>

    <Color x:Key="Primary">#FF8A3D</Color>
    <Color x:Key="PrimaryDeep">#D3641F</Color>
    <Color x:Key="PrimarySoft">#FFE6D0</Color>
    <Color x:Key="OnPrimary">#4A2103</Color>

    <Color x:Key="Accent">#2FC0A4</Color>
    <Color x:Key="AccentDeep">#1E9683</Color>
    <Color x:Key="AccentSoft">#D6F5EE</Color>
    <Color x:Key="OnAccent">#06322A</Color>
    <Color x:Key="OnAccentSoft">#14705F</Color>

    <Color x:Key="Sky">#4FA8F5</Color>
    <Color x:Key="SkyDeep">#2F7ECB</Color>
    <Color x:Key="OnSky">#06294A</Color>

    <Color x:Key="Gold">#FFC244</Color>
    <Color x:Key="GoldDeep">#8A6000</Color>

    <Color x:Key="Warn">#EF6C5A</Color>
    <Color x:Key="WarnDeep">#C44B3B</Color>
    <Color x:Key="WarnSoft">#FFE2DC</Color>
    <Color x:Key="OnWarn">#3D0C04</Color>
    <Color x:Key="OnWarnSoft">#9B3527</Color>

    <Color x:Key="Good">#3FBF7F</Color>

</ResourceDictionary>
