<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- iOS / Android / Mac Catalyst always; Windows only when building on Windows. -->
    <TargetFrameworks Condition="'$(SquarebuzzTargetFramework)' == ''">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(SquarebuzzTargetFramework)' == '' AND $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <!--
      Escape hatch for a CI job that installs one platform's workload.

      Restore covers every framework a project declares, whichever one is being built, so
      `-f net10.0-android` alone still demands the iOS, Mac Catalyst and Windows workloads and
      fails with NETSDK1147 on a runner that has only the Android one.

      It has to be a property of our own rather than overriding TargetFrameworks on the command
      line. A command-line property is global and propagates into ProjectReferences, so
      `-p:TargetFrameworks=net10.0-android` also redefines Squarebuzz.Core and Squarebuzz.Data -
      which target plain net10.0 - and the build fails looking for assets that were never
      restored. Core and Data do not read this property, so they are unaffected.
    -->
    <TargetFrameworks Condition="'$(SquarebuzzTargetFramework)' != ''">$(SquarebuzzTargetFramework)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Squarebuzz.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>

    <!--
      Compile bindings that set Source too. Without this, the six RelativeSource bindings that
      reach a page's ViewModel from inside a DataTemplate stay reflection-based and each raises
      XC0025 - harmless on its own, but the CI job that builds this project with -warnaserror
      turns all six into build failures. Every such binding carries an explicit x:DataType.
    -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationTitle>squarebuzz</ApplicationTitle>
    <ApplicationId>co.equilibrium.squarebuzz</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!--
      MAUI's own generated partial classes trip a few analyser rules, so the solution-wide
      warnings-as-errors is relaxed here only. Core and Data keep it on.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon and splash are generated from these vectors for every platform. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFF6EA" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFF6EA" BaseSize="128,128" />

    <MauiImage Include="Resources\Images\*" />
    <!-- .ttf only: the folder also holds the OFL licence files and a README. -->
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="Plugin.Maui.Audio" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Squarebuzz.Core\Squarebuzz.Core.csproj" />
    <ProjectReference Include="..\Squarebuzz.Data\Squarebuzz.Data.csproj" />
    <ProjectReference Include="..\Squarebuzz.Presentation\Squarebuzz.Presentation.csproj" />
  </ItemGroup>

  <!--
    iOS and Mac Catalyst share UIKit, so the platform partials that talk to it live once in
    Platforms\Apple rather than twice. The MAUI SDK compiles only the folder named after the
    current head, so anything else under Platforms\ has to be added back by hand for the heads
    it belongs to.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <Compile Include="Platforms\Apple\**\*.cs" />
  </ItemGroup>

</Project>
