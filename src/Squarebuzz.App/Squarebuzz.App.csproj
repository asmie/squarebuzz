<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- iOS / Android / Mac Catalyst always; Windows only when building on Windows. -->
    <TargetFrameworks Condition="'$(SquarebuzzTargetFramework)' == ''">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(SquarebuzzTargetFramework)' == '' AND $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <!-- Select one app platform without changing the target framework of referenced libraries. -->
    <TargetFrameworks Condition="'$(SquarebuzzTargetFramework)' != ''">$(SquarebuzzTargetFramework)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Squarebuzz.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>

    <!-- Compile bindings with an explicit Source and x:DataType. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationTitle>squarebuzz</ApplicationTitle>
    <ApplicationId>fun.asmie.squarebuzz</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>6</ApplicationVersion>

    <!--
      MAUI's own generated partial classes trip a few analyser rules, so the solution-wide
      warnings-as-errors is relaxed here only. Core and Data keep it on.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidCreateProguardMappingFile>true</AndroidCreateProguardMappingFile>
    <AndroidManagedSymbols>true</AndroidManagedSymbols>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <!-- Keep AOT symbols in intermediate files; strip the copies packaged for users. -->
    <_AndroidAotStripLibraries>false</_AndroidAotStripLibraries>
    <AndroidStripNativeLibraries>true</AndroidStripNativeLibraries>
    <AndroidIncludeDebugSymbols>false</AndroidIncludeDebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- Store reserves the fourth component; use the app build in the third component. -->
    <SquarebuzzWindowsDisplayVersion Condition="'$(SquarebuzzWindowsDisplayVersion)' == ''">$([System.Version]::Parse('$(ApplicationDisplayVersion)').Major).$([System.Version]::Parse('$(ApplicationDisplayVersion)').Minor).$(ApplicationVersion)</SquarebuzzWindowsDisplayVersion>
    <ApplicationDisplayVersion>$(SquarebuzzWindowsDisplayVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>0</ApplicationVersion>
    <!-- Keep the RID override local to the app, as recommended by the MAUI publishing guide. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifierOverride)' != ''">$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <Import Project="Platforms\Android\ReleaseDiagnostics.targets" />

  <ItemGroup>
    <!-- App icon and splash are generated from these vectors for every platform. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFF6EA" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFF6EA" BaseSize="128,128" />

    <MauiImage Include="Resources\Images\*" />
    <!-- .ttf only: the folder also holds the OFL licence files and a README. -->
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Plugin.Maui.Audio" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Squarebuzz.Core\Squarebuzz.Core.csproj" />
    <ProjectReference Include="..\Squarebuzz.Data\Squarebuzz.Data.csproj" />
    <ProjectReference Include="..\Squarebuzz.Presentation\Squarebuzz.Presentation.csproj" />
  </ItemGroup>

</Project>
