<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Squarebuzz.Presentation.ViewModels;assembly=Squarebuzz.Presentation"
             xmlns:controls="clr-namespace:Squarebuzz.App.Controls"
             xmlns:conv="clr-namespace:Squarebuzz.App.Converters"
             x:Class="Squarebuzz.App.Views.TrialsPage"
             x:DataType="vm:TrialsViewModel"
             BackgroundColor="{DynamicResource Bg}">

    <ContentPage.Resources>
        <conv:BoolSelectConverter x:Key="TabBackground"
                                  TrueKey="Primary"
                                  FalseKey="Surface2" />
        <conv:BoolSelectConverter x:Key="TabTextColor"
                                  TrueKey="OnPrimary"
                                  FalseKey="Ink" />
        <conv:BoolSelectConverter x:Key="TrophyStroke"
                                  TrueKey="Gold"
                                  FalseKey="Line" />

        <!-- Calendar day cells: done days filled, today outlined, the rest quiet. -->
        <conv:BoolSelectConverter x:Key="DayFill"
                                  TrueKey="Primary"
                                  FalseValue="{x:Static Colors.Transparent}" />
        <conv:BoolSelectConverter x:Key="DayStroke"
                                  TrueKey="PrimaryDeep"
                                  FalseValue="{x:Static Colors.Transparent}" />
        <conv:BoolSelectConverter x:Key="DayText"
                                  TrueKey="OnPrimary"
                                  FalseKey="Ink2" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="{StaticResource PagePadding}" RowSpacing="12">

        <Label Grid.Row="0" Text="{Binding Heading}" Style="{StaticResource H1}"
               SemanticProperties.HeadingLevel="Level1" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0"
                    Text="{Binding DailyTabLabel}"
                    Command="{Binding ShowDailyCommand}"
                    BackgroundColor="{Binding IsDailyTab, Converter={StaticResource TabBackground}}"
                    TextColor="{Binding IsDailyTab, Converter={StaticResource TabTextColor}}"
                    CornerRadius="16"
                    HeightRequest="50"
                    FontSize="12"
                    FontFamily="BodyBold" />
            <Button Grid.Column="1"
                    Text="{Binding TimedTabLabel}"
                    Command="{Binding ShowTimedCommand}"
                    BackgroundColor="{Binding IsTimedTab, Converter={StaticResource TabBackground}}"
                    TextColor="{Binding IsTimedTab, Converter={StaticResource TabTextColor}}"
                    CornerRadius="16"
                    HeightRequest="50"
                    FontSize="12"
                    FontFamily="BodyBold" />
            <Button Grid.Column="2"
                    Text="{Binding TrophiesTabLabel}"
                    Command="{Binding ShowTrophiesCommand}"
                    BackgroundColor="{Binding IsTrophiesTab, Converter={StaticResource TabBackground}}"
                    TextColor="{Binding IsTrophiesTab, Converter={StaticResource TabTextColor}}"
                    CornerRadius="16"
                    HeightRequest="50"
                    FontSize="12"
                    FontFamily="BodyBold" />
        </Grid>

        <!-- Daily -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsDailyTab}" Spacing="14">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding TodayLabel}" Style="{StaticResource Subtle}"
                               FontSize="13" VerticalOptions="Center" />

                        <!-- The streak flame the design puts on this tab: celebrated, never punished. -->
                        <Border Grid.Column="1"
                                SemanticProperties.Description="{Binding StreakDescription}"
                                BackgroundColor="{DynamicResource Surface2}"
                                Stroke="{DynamicResource Line}"
                                StrokeThickness="2"
                                Padding="12,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="999" />
                            </Border.StrokeShape>
                            <Label FontFamily="BodyBold" FontSize="14" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="🔥 " />
                                        <Span Text="{Binding Streak}" TextColor="{DynamicResource Ink}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Border>
                    </Grid>
                    <Label Text="{Binding DailyTitle}" Style="{StaticResource H2}" />
                    <Label Text="{Binding DailySubtitle}" Style="{StaticResource Subtle}" />

                    <controls:MascotView Pose="Idle" HeightRequest="90" WidthRequest="84"
                                         HorizontalOptions="Center" InputTransparent="True"
                                         AutomationProperties.ExcludedWithChildren="True" />

                    <!--
                      The month at a glance: every day the daily was finished gets its dot. The
                      cells are decorative for a screen reader - the summary sentence on the
                      container carries the same fact in words.
                    -->
                    <Label Text="{Binding MonthLabel}"
                           Style="{StaticResource Subtle}"
                           FontFamily="BodyBold"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />

                    <ContentView SemanticProperties.Description="{Binding CalendarDescription}">
                        <FlexLayout BindableLayout.ItemsSource="{Binding CalendarDays}"
                                    AutomationProperties.ExcludedWithChildren="True"
                                    Wrap="Wrap"
                                    JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarDayCell">
                                    <!-- Exactly seven per row: each cell is one seventh wide. -->
                                    <ContentView FlexLayout.Basis="14.28%" HeightRequest="38">
                                        <Border BackgroundColor="{Binding IsDone, Converter={StaticResource DayFill}}"
                                                Stroke="{Binding IsToday, Converter={StaticResource DayStroke}}"
                                                StrokeThickness="2"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="999" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Label}"
                                                   FontSize="12"
                                                   FontFamily="BodyBold"
                                                   TextColor="{Binding IsDone, Converter={StaticResource DayText}}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                        </Border>
                                    </ContentView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </ContentView>

                    <Button Text="{Binding PlayLabel}"
                            Command="{Binding PlayDailyCommand}"
                            IsVisible="{Binding IsDailyAvailable}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="56" />

                    <Label Text="{Binding DailyDoneLabel}"
                           IsVisible="{Binding IsDailyAvailable, Converter={StaticResource InvertBool}}"
                           Style="{StaticResource Subtle}"
                           FontFamily="BodyBold"
                           TextColor="{DynamicResource AccentDeep}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Timed Trial: three rungs, hardest last. -->
        <ScrollView Grid.Row="2" IsVisible="{Binding IsTimedTab}">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Timed}" Spacing="14">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimedCard">
                        <Border Style="{StaticResource Card}"
                                SemanticProperties.Description="{Binding Description}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        BackgroundColor="{DynamicResource Surface2}"
                                        Stroke="{DynamicResource Line}"
                                        StrokeThickness="2"
                                        Padding="12,8"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Clock}"
                                           FontFamily="Display"
                                           FontSize="22"
                                           TextColor="{DynamicResource Ink}" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource H2}" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Subtle}" FontSize="13" />
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="▶"
                                        SemanticProperties.Description="{Binding Description}"
                                        Command="{Binding Path=PlayTimedCommand, Source={RelativeSource AncestorType={x:Type vm:TrialsViewModel}}, x:DataType=vm:TrialsViewModel}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{DynamicResource Primary}"
                                        TextColor="{DynamicResource OnPrimary}"
                                        CornerRadius="999"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        Padding="0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Trophies -->
        <Grid Grid.Row="2" IsVisible="{Binding IsTrophiesTab}" RowDefinitions="Auto,*" RowSpacing="8">
            <Label Grid.Row="0" Text="{Binding EarnedSummary}" Style="{StaticResource Subtle}" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding Trophies}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrophyCard">
                        <Border SemanticProperties.Description="{Binding Description}"
                                BackgroundColor="{DynamicResource Surface}"
                                Stroke="{Binding IsEarned, Converter={StaticResource TrophyStroke}}"
                                StrokeThickness="3"
                                Padding="12"
                                Opacity="{Binding Opacity}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="{Binding Icon}"
                                       FontSize="30"
                                       VerticalOptions="Center" />

                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalOptions="Center">
                                    <Label Grid.Row="0" Text="{Binding Name}" FontFamily="BodyBold" />
                                    <!-- Explicit size: see the note on HowToPage about labels in
                                         templates reserving one line too few. -->
                                    <Label Grid.Row="1"
                                           Text="{Binding Hint}"
                                           FontSize="12"
                                           TextColor="{DynamicResource Ink2}"
                                           LineBreakMode="WordWrap" />
                                </Grid>

                                <Label Grid.Column="2"
                                       Text="{Binding EarnedOn}"
                                       FontSize="11"
                                       TextColor="{DynamicResource Ink2}"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
