<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Squarebuzz.App.ViewModels"
             xmlns:controls="clr-namespace:Squarebuzz.App.Controls"
             xmlns:conv="clr-namespace:Squarebuzz.App.Converters"
             x:Class="Squarebuzz.App.Views.TrialsPage"
             x:DataType="vm:TrialsViewModel"
             BackgroundColor="{DynamicResource Bg}">

    <ContentPage.Resources>
        <conv:BoolSelectConverter x:Key="TabBackground"
                                  TrueValue="{StaticResource Primary}"
                                  FalseValue="{StaticResource Surface2}" />
        <conv:BoolSelectConverter x:Key="TabTextColor"
                                  TrueValue="{StaticResource OnPrimary}"
                                  FalseValue="{StaticResource Ink}" />
        <conv:PathStateSelectConverter x:Key="NodeFill"
                                      DoneValue="{StaticResource Accent}"
                                      CurrentValue="{StaticResource Primary}"
                                      LockedValue="{StaticResource Surface}" />
        <conv:PathStateSelectConverter x:Key="NodeStroke"
                                      DoneValue="{StaticResource AccentDeep}"
                                      CurrentValue="{StaticResource PrimaryDeep}"
                                      LockedValue="{StaticResource Line}" />
        <conv:PathStateSelectConverter x:Key="NodeInk"
                                      DoneValue="{StaticResource OnAccent}"
                                      CurrentValue="{StaticResource OnPrimary}"
                                      LockedValue="{StaticResource Ink2}" />
        <conv:PathStateSelectConverter x:Key="TrailInk"
                                      DoneValue="{StaticResource Accent}"
                                      CurrentValue="{StaticResource Line}"
                                      LockedValue="{StaticResource Line}" />

        <conv:BoolSelectConverter x:Key="TrophyStroke"
                                  TrueValue="{StaticResource Gold}"
                                  FalseValue="{StaticResource Line}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="{StaticResource PagePadding}" RowSpacing="12">

        <Label Grid.Row="0" Text="{Binding Heading}" Style="{StaticResource H1}"
               SemanticProperties.HeadingLevel="Level1" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0"
                    Text="{Binding DailyTabLabel}"
                    Command="{Binding ShowDailyCommand}"
                    BackgroundColor="{Binding IsDailyTab, Converter={StaticResource TabBackground}}"
                    TextColor="{Binding IsDailyTab, Converter={StaticResource TabTextColor}}"
                    CornerRadius="16"
                    HeightRequest="50"
                    FontSize="12"
                    FontFamily="BodyBold" />
            <Button Grid.Column="1"
                    Text="{Binding TimedTabLabel}"
                    Command="{Binding ShowTimedCommand}"
                    BackgroundColor="{Binding IsTimedTab, Converter={StaticResource TabBackground}}"
                    TextColor="{Binding IsTimedTab, Converter={StaticResource TabTextColor}}"
                    CornerRadius="16"
                    HeightRequest="50"
                    FontSize="12"
                    FontFamily="BodyBold" />
            <Button Grid.Column="2"
                    Text="{Binding PathTabLabel}"
                    Command="{Binding ShowPathCommand}"
                    BackgroundColor="{Binding IsPathTab, Converter={StaticResource TabBackground}}"
                    TextColor="{Binding IsPathTab, Converter={StaticResource TabTextColor}}"
                    CornerRadius="16"
                    HeightRequest="50"
                    FontSize="12"
                    FontFamily="BodyBold" />
            <Button Grid.Column="3"
                    Text="{Binding TrophiesTabLabel}"
                    Command="{Binding ShowTrophiesCommand}"
                    BackgroundColor="{Binding IsTrophiesTab, Converter={StaticResource TabBackground}}"
                    TextColor="{Binding IsTrophiesTab, Converter={StaticResource TabTextColor}}"
                    CornerRadius="16"
                    HeightRequest="50"
                    FontSize="12"
                    FontFamily="BodyBold" />
        </Grid>

        <!-- Daily -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsDailyTab}" Spacing="14">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding TodayLabel}" Style="{StaticResource Subtle}" FontSize="13" />
                    <Label Text="{Binding DailyTitle}" Style="{StaticResource H2}" />
                    <Label Text="{Binding DailySubtitle}" Style="{StaticResource Subtle}" />

                    <controls:MascotView Pose="Idle" HeightRequest="90" WidthRequest="84"
                                         HorizontalOptions="Center" InputTransparent="True"
                                         AutomationProperties.ExcludedWithChildren="True" />

                    <Button Text="{Binding PlayLabel}"
                            Command="{Binding PlayDailyCommand}"
                            IsVisible="{Binding IsDailyAvailable}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="56" />

                    <Label Text="{Binding DailyDoneLabel}"
                           IsVisible="{Binding IsDailyAvailable, Converter={StaticResource InvertBool}}"
                           Style="{StaticResource Subtle}"
                           FontFamily="BodyBold"
                           TextColor="{DynamicResource AccentDeep}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Timed Trial: three rungs, hardest last. -->
        <ScrollView Grid.Row="2" IsVisible="{Binding IsTimedTab}">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Timed}" Spacing="14">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimedCard">
                        <Border Style="{StaticResource Card}"
                                SemanticProperties.Description="{Binding Description}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        BackgroundColor="{DynamicResource Surface2}"
                                        Stroke="{DynamicResource Line}"
                                        StrokeThickness="2"
                                        Padding="12,8"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Clock}"
                                           FontFamily="Display"
                                           FontSize="22"
                                           TextColor="{DynamicResource Ink}" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource H2}" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Subtle}" FontSize="13" />
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="▶"
                                        SemanticProperties.Description="{Binding Description}"
                                        Command="{Binding Path=PlayTimedCommand, Source={RelativeSource AncestorType={x:Type vm:TrialsViewModel}}, x:DataType=vm:TrialsViewModel}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{DynamicResource Primary}"
                                        TextColor="{DynamicResource OnPrimary}"
                                        CornerRadius="999"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        Padding="0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!--
          Puzzle Path. A plain vertical list whose items lean sideways on an eight-step cycle,
          which is what turns a column of circles into a trail - see PathCard.Offset.
        -->
        <Grid Grid.Row="2" IsVisible="{Binding IsPathTab}" RowDefinitions="Auto,*" RowSpacing="8">
            <Label Grid.Row="0" Text="{Binding PathSummary}" Style="{StaticResource Subtle}" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Path}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PathCard">
                            <VerticalStackLayout Spacing="0" TranslationX="{Binding Offset}">
                                <Border SemanticProperties.Description="{Binding Description}"
                                        BackgroundColor="{Binding State, Converter={StaticResource NodeFill}}"
                                        Stroke="{Binding State, Converter={StaticResource NodeStroke}}"
                                        StrokeThickness="3"
                                        WidthRequest="{Binding Diameter}"
                                        HeightRequest="{Binding Diameter}"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="999" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Path=PlayNodeCommand, Source={RelativeSource AncestorType={x:Type vm:TrialsViewModel}}, x:DataType=vm:TrialsViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Label Text="{Binding Caption}"
                                           FontFamily="Display"
                                           FontSize="{Binding FontSize}"
                                           TextColor="{Binding State, Converter={StaticResource NodeInk}}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           InputTransparent="True" />
                                </Border>

                                <!-- Three dots joining this stop to the next. Not after the last. -->
                                <VerticalStackLayout Spacing="4"
                                                     Margin="0,4"
                                                     HorizontalOptions="Center"
                                                     IsVisible="{Binding IsLast, Converter={StaticResource InvertBool}}">
                                    <BoxView WidthRequest="5" HeightRequest="5" CornerRadius="3"
                                             Color="{Binding State, Converter={StaticResource TrailInk}}" />
                                    <BoxView WidthRequest="5" HeightRequest="5" CornerRadius="3"
                                             Color="{Binding State, Converter={StaticResource TrailInk}}" />
                                    <BoxView WidthRequest="5" HeightRequest="5" CornerRadius="3"
                                             Color="{Binding State, Converter={StaticResource TrailInk}}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Trophies -->
        <Grid Grid.Row="2" IsVisible="{Binding IsTrophiesTab}" RowDefinitions="Auto,*" RowSpacing="8">
            <Label Grid.Row="0" Text="{Binding EarnedSummary}" Style="{StaticResource Subtle}" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding Trophies}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrophyCard">
                        <Border SemanticProperties.Description="{Binding Description}"
                                BackgroundColor="{DynamicResource Surface}"
                                Stroke="{Binding IsEarned, Converter={StaticResource TrophyStroke}}"
                                StrokeThickness="3"
                                Padding="12"
                                Opacity="{Binding Opacity}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="{Binding Icon}"
                                       FontSize="30"
                                       VerticalOptions="Center" />

                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalOptions="Center">
                                    <Label Grid.Row="0" Text="{Binding Name}" FontFamily="BodyBold" />
                                    <!-- Explicit size: see the note on HowToPage about labels in
                                         templates reserving one line too few. -->
                                    <Label Grid.Row="1"
                                           Text="{Binding Hint}"
                                           FontSize="12"
                                           TextColor="{DynamicResource Ink2}"
                                           LineBreakMode="WordWrap" />
                                </Grid>

                                <Label Grid.Column="2"
                                       Text="{Binding EarnedOn}"
                                       FontSize="11"
                                       TextColor="{DynamicResource Ink2}"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
