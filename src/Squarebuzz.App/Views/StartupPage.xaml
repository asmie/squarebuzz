<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Squarebuzz.App.ViewModels"
             x:Class="Squarebuzz.App.Views.StartupPage"
             x:DataType="vm:StartupViewModel"
             BackgroundColor="{DynamicResource Bg}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}"
                             Spacing="20"
                             MaximumWidthRequest="{StaticResource FrameMaxWidth}"
                             HorizontalOptions="Center">

            <VerticalStackLayout Spacing="4">
                <Label Text="squarebuzz" Style="{StaticResource H1}" />
                <Label Style="{StaticResource Subtle}"
                       Text="Structure milestone - verifying DI, Shell and runtime theming." />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Active palette" Style="{StaticResource H2}" />

                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Theme:" Style="{StaticResource Subtle}" />
                        <Label Text="{Binding ThemeName}" FontAttributes="Bold" />
                        <Label Text="Accent:" Style="{StaticResource Subtle}" />
                        <Label Text="{Binding AccentName}" FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <!-- Every swatch uses DynamicResource, so tapping the buttons below
                         re-colours them live and proves the dictionary swap works. -->
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignContent="Start">
                        <Border BackgroundColor="{DynamicResource Primary}" WidthRequest="76" HeightRequest="52" Margin="0,0,6,6" StrokeThickness="0">
                            <Label Text="Primary" FontSize="11" TextColor="{DynamicResource OnPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border BackgroundColor="{DynamicResource Accent}" WidthRequest="76" HeightRequest="52" Margin="0,0,6,6" StrokeThickness="0">
                            <Label Text="Accent" FontSize="11" TextColor="{DynamicResource OnAccent}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border BackgroundColor="{DynamicResource Sky}" WidthRequest="76" HeightRequest="52" Margin="0,0,6,6" StrokeThickness="0">
                            <Label Text="Sky" FontSize="11" TextColor="{DynamicResource OnSky}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border BackgroundColor="{DynamicResource Gold}" WidthRequest="76" HeightRequest="52" Margin="0,0,6,6" StrokeThickness="0">
                            <Label Text="Gold" FontSize="11" TextColor="{DynamicResource GoldDeep}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border BackgroundColor="{DynamicResource Warn}" WidthRequest="76" HeightRequest="52" Margin="0,0,6,6" StrokeThickness="0">
                            <Label Text="Warn" FontSize="11" TextColor="{DynamicResource OnWarn}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border BackgroundColor="{DynamicResource CellFill}" WidthRequest="76" HeightRequest="52" Margin="0,0,6,6" StrokeThickness="0">
                            <Label Text="CellFill" FontSize="11" TextColor="{DynamicResource CellEmpty}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Domain self-check" Style="{StaticResource H2}" />
                    <Label Text="{Binding ContentSummary}" Style="{StaticResource Subtle}" />
                    <Label Text="{Binding SolverSummary}" Style="{StaticResource Subtle}" />
                    <Label Text="{Binding GeneratorSummary}" Style="{StaticResource Subtle}" />
                    <Label Text="{Binding StorageSummary}" Style="{StaticResource Subtle}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Play a puzzle" Style="{StaticResource PrimaryButton}" HeightRequest="56" Command="{Binding PlayCommand}" />
            <Button Text="Cycle theme" Style="{StaticResource SecondaryButton}" Command="{Binding CycleThemeCommand}" />
            <Button Text="Cycle accent" Style="{StaticResource SecondaryButton}" Command="{Binding CycleAccentCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
