<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Squarebuzz.App.ViewModels"
             xmlns:controls="clr-namespace:Squarebuzz.App.Controls"
             x:Class="Squarebuzz.App.Views.MenuPage"
             x:DataType="vm:MenuViewModel"
             BackgroundColor="{DynamicResource Bg}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}"
                             Spacing="18"
                             MaximumWidthRequest="{StaticResource FrameMaxWidth}"
                             HorizontalOptions="Center">

            <!-- Header: wordmark, stars and streak -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <controls:MascotView Grid.Column="0"
                                     AutomationProperties.ExcludedWithChildren="True"
                                     Pose="{Binding MascotPose}"
                                     HeightRequest="72"
                                     WidthRequest="66" />

                <Label Grid.Column="1" VerticalOptions="Center" FontSize="34" FontFamily="BodyBold">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="square" TextColor="{DynamicResource Ink}" />
                            <Span Text="buzz" TextColor="{DynamicResource PrimaryDeep}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                    <Label HorizontalTextAlignment="End" FontFamily="BodyBold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="★ " TextColor="{DynamicResource Gold}" />
                                <Span Text="{Binding Stars}" TextColor="{DynamicResource Ink}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label HorizontalTextAlignment="End" FontSize="13" TextColor="{DynamicResource Ink2}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="🔥 " />
                                <Span Text="{Binding Streak}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Grid>

            <!-- The mascot's line, so the menu feels answered rather than static -->
            <Border Style="{StaticResource Card}" Padding="14">
                <Label Text="{Binding Greeting}" Style="{StaticResource Subtle}" FontFamily="BodyBold" />
            </Border>

            <!-- Primary action gets the full-width treatment; the rest are equals below it. -->
            <Button Text="{Binding NewGameLabel}"
                    Command="{Binding NewGameCommand}"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="64"
                    FontSize="20" />

            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Button Command="{Binding ContinueCommand}"
                            IsEnabled="{Binding HasSaves}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Ink}"
                            HeightRequest="64"
                            FontFamily="BodyBold"
                            Text="{Binding ContinueLabel}" />
                    <Label Text="{Binding ContinueSubtitle}"
                           Style="{StaticResource Subtle}"
                           FontSize="13"
                           Margin="16,0,16,10" />
                </VerticalStackLayout>
            </Border>

            <!--
              Poster buttons, as the design draws them: the destination plus one line of why
              you would go there. Same shape as the Continue card above.
            -->
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Button Text="{Binding TrialsLabel}"
                            Command="{Binding TrialsCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Ink}"
                            HeightRequest="60"
                            FontFamily="BodyBold" />
                    <Label Text="{Binding TrialsSubtitle}"
                           Style="{StaticResource Subtle}"
                           FontSize="13"
                           Margin="16,0,16,10" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Button Text="{Binding OptionsLabel}"
                            Command="{Binding OptionsCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Ink}"
                            HeightRequest="60"
                            FontFamily="BodyBold" />
                    <Label Text="{Binding OptionsSubtitle}"
                           Style="{StaticResource Subtle}"
                           FontSize="13"
                           Margin="16,0,16,10" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Button Text="{Binding AboutLabel}"
                            Command="{Binding AboutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Ink}"
                            HeightRequest="60"
                            FontFamily="BodyBold" />
                    <Label Text="{Binding AboutSubtitle}"
                           Style="{StaticResource Subtle}"
                           FontSize="13"
                           Margin="16,0,16,10" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
