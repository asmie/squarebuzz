<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Squarebuzz.Presentation.ViewModels;assembly=Squarebuzz.Presentation"
             xmlns:controls="clr-namespace:Squarebuzz.App.Controls"
             x:Class="Squarebuzz.App.Views.AboutPage"
             x:DataType="vm:AboutViewModel"
             Title="{Binding Heading}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource Bg}">

    <Grid SafeAreaEdges="All">
        <ScrollView AutomationProperties.ExcludedWithChildren="{Binding Gate.IsOpen}">
            <VerticalStackLayout Padding="{StaticResource PagePadding}"
                                 Spacing="14"
                                 MaximumWidthRequest="{StaticResource FrameMaxWidth}"
                                 HorizontalOptions="Center">

                <Label Text="{Binding Heading}" Style="{StaticResource H1}" SemanticProperties.HeadingLevel="Level1" />

                <controls:MascotView Pose="Idle" HeightRequest="90" WidthRequest="84" HorizontalOptions="Center" AutomationProperties.ExcludedWithChildren="True" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding WhatIsTitle}" Style="{StaticResource H2}" />
                        <Label Text="{Binding WhatIsBody}" Style="{StaticResource Subtle}" />
                        <Label Text="{Binding AlsoCalled}"
                               Style="{StaticResource Subtle}"
                               FontSize="12"
                               FontAttributes="Italic" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Button Text="{Binding HowToLabel}" Command="{Binding HowToCommand}"
                                Style="{StaticResource GhostButton}" HeightRequest="56" />
                        <Button Text="{Binding PrivacyLabel}" Command="{Binding PrivacyCommand}"
                                Style="{StaticResource GhostButton}" HeightRequest="56" />
                        <Button Text="{Binding RateLabel}" Command="{Binding RateCommand}"
                                IsVisible="{Binding CanRate}"
                                Style="{StaticResource GhostButton}" HeightRequest="56" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding Notice}"
                       IsVisible="{Binding HasNotice}"
                       Style="{StaticResource Subtle}"
                       FontFamily="BodyBold"
                       TextColor="{DynamicResource PrimaryDeep}"
                       HorizontalTextAlignment="Center" />

                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding VersionLabel}" Style="{StaticResource Subtle}" FontSize="12"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding NoAdsLabel}" Style="{StaticResource Subtle}" FontSize="12"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Grown-ups' check, shared with Options. See ParentGate. -->
        <controls:ParentGateOverlay BindingContext="{Binding Gate}" />
    </Grid>

</ContentPage>
