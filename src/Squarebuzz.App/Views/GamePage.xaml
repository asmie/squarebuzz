<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Squarebuzz.Presentation.ViewModels;assembly=Squarebuzz.Presentation"
             xmlns:controls="clr-namespace:Squarebuzz.App.Controls"
             x:Class="Squarebuzz.App.Views.GamePage"
             x:DataType="vm:GameViewModel"
             BackgroundColor="{DynamicResource Bg}">

    <!-- Outer grid layers the pause and win overlays over the board. -->
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="All">
        <Border Grid.Row="0" IsVisible="{Binding HasPersistenceFailure}"
                BackgroundColor="{DynamicResource Surface2}" Stroke="{DynamicResource Line}"
                Padding="12,8">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding PersistenceFailureText}" TextColor="{DynamicResource Ink}"
                       SemanticProperties.HeadingLevel="Level2" />
                <Button Text="{Binding RetryPersistenceText}" Command="{Binding RetryPersistenceCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>
        </Border>
        <Grid Grid.Row="1">
    <!--
      Row layout on a phone, and a two-column layout on a wide landscape screen - see
      GamePage.ApplyLayout. The definitions and the children's positions are set from code
      because MAUI has no media queries.
    -->
    <Grid x:Name="PlayLayout"
          AutomationProperties.ExcludedWithChildren="{Binding HasGameOverlay}"
          RowDefinitions="Auto,*,Auto"
          Padding="{StaticResource PagePadding}"
          RowSpacing="12"
          ColumnSpacing="16">

        <!-- Status bar: picture name, counters, progress ring, timer, pause -->
        <Grid x:Name="StatusBar" Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding PuzzleName}" Style="{StaticResource H2}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding StatusText}" Style="{StaticResource Subtle}" FontSize="14" />
            </VerticalStackLayout>

            <!-- Glanceable progress; screen readers get the same fact via the board summary. -->
            <controls:ProgressRingView Grid.Column="1"
                                       Progress="{Binding Progress}"
                                       AutomationProperties.ExcludedWithChildren="True"
                                       WidthRequest="40"
                                       HeightRequest="40"
                                       VerticalOptions="Center" />

            <!-- Glyph-only, so the only thing a screen reader has to go on is this. -->
            <Button Grid.Column="2"
                    Text="⏸"
                    SemanticProperties.Description="{Binding PauseText}"
                    Command="{Binding PauseCommand}"
                    BackgroundColor="{DynamicResource Surface2}"
                    TextColor="{DynamicResource Ink}"
                    CornerRadius="999"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    VerticalOptions="Center" />

            <Border Grid.Column="3"
                    IsVisible="{Binding ShowTimer}"
                    SemanticProperties.Description="{Binding ElapsedDescription}"
                    BackgroundColor="{DynamicResource Surface2}"
                    Stroke="{DynamicResource Line}"
                    StrokeThickness="2"
                    Padding="14,8"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="999" />
                </Border.StrokeShape>
                <Label Text="{Binding ElapsedText}" FontFamily="BodyBold" FontSize="18" />
            </Border>
        </Grid>

        <!-- The board. Scrollable on both axes so a 25x25 grid stays reachable on a phone. -->
        <!--
          The host fills the row, so its measured size IS the space available to the board.
          The board then centres itself inside it, and the host scrolls only when the board
          is genuinely larger.
        -->
        <ScrollView Grid.Row="1"
                    x:Name="BoardHost"
                    Orientation="Both"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
            <!--
              A GraphicsView adds nothing to the accessibility tree, so without this the board is
              simply not there for a screen reader. See GameViewModel.BoardDescription.
            -->
            <!--
              The board and, over it, the per-cell accessibility overlay. One container so the two
              share an origin: the overlay is inset by the clue gutters and then lays out a cell-sized
              grid, which is the only way it can line up with squares drawn on a canvas.
            -->
            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                <controls:BoardView x:Name="Board"
                                    SemanticProperties.Description="{Binding BoardDescription}"
                                    Session="{Binding Session}"
                                    ZoomPercent="{Binding ZoomPercent}"
                                    BigNumbers="{Binding BigNumbers}"
                                    TapBehaviour="{Binding TapBehaviour}" />

                <!-- Built in code, and only when a screen reader is running. See GamePage.BuildCellOverlay. -->
                <Grid x:Name="CellOverlay" IsVisible="False" />
            </Grid>
        </ScrollView>

        <!--
          Magnifier, opt-in via Options. Parked in a corner of the board area rather than
          following the finger: a panel under the palm would defeat the point, and pinning it
          avoids translating touch coordinates up through the ScrollView. The corner flips to
          whichever side the hand is not on.
        -->
        <!--
          Overview map for boards bigger than their viewport - 15x15 and up on a phone. Bottom
          corner, opposite nothing in particular: the magnifier owns the top and the two must
          not fight over it. Shown from code when the board actually scrolls.
        -->
        <controls:BoardMiniMapView Grid.Row="1"
                                   x:Name="MiniMap"
                                   IsVisible="False"
                                   AutomationProperties.ExcludedWithChildren="True"
                                   WidthRequest="104"
                                   HeightRequest="104"
                                   Margin="4"
                                   VerticalOptions="End"
                                   HorizontalOptions="End" />

        <Border Grid.Row="1"
                x:Name="MagnifierPanel"
                IsVisible="False"
                WidthRequest="116"
                HeightRequest="116"
                Padding="6"
                Margin="4"
                VerticalOptions="Start"
                HorizontalOptions="End"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource Line}"
                StrokeThickness="2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <controls:MagnifierView x:Name="Magnifier" Session="{Binding Session}"
                                    AutomationProperties.ExcludedWithChildren="True" />
        </Border>

        <!--
          "Line done!" / "Oops". An overlay pinned to the bottom of the board area, not a row in
          the controls panel, because it comes and goes *while the player is dragging*. As a
          laid-out child it took its height out of the star-sized board row, and the board -
          centred in what was left - jumped up by half of that. Mid-drag, that moved the grid out
          from under the finger and the rest of the stroke painted a row off. Being an overlay it
          costs the board no space at all, which also means it no longer has to be paid for on
          every board that never sees a toast.
        -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasToast}"
                InputTransparent="True"
                Padding="16,7"
                Margin="8"
                VerticalOptions="End"
                HorizontalOptions="Center"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource Line}"
                StrokeThickness="2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="999" />
            </Border.StrokeShape>
            <Label Text="{Binding Toast}"
                   Style="{StaticResource Subtle}"
                   HorizontalOptions="Center"
                   FontFamily="BodyBold"
                   TextColor="{DynamicResource PrimaryDeep}" />
        </Border>

        <!-- Controls -->
        <VerticalStackLayout x:Name="ControlsPanel" Grid.Row="2" Spacing="10">

            <!--
              Columns come from the ViewModel so the Handedness setting can reorder the row -
              see GameViewModel.UndoColumn for why this is not FlowDirection.
            -->
            <Grid x:Name="ActionGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" RowSpacing="8">
                <Button Grid.Column="{Binding UndoColumn}"
                        Grid.Row="{Binding UndoRow}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="13"
                        Padding="4,0"
                        Command="{Binding UndoCommand}"
                        IsEnabled="{Binding CanUndo}"
                        Text="{Binding UndoText}" />

                <Button Grid.Column="{Binding RedoColumn}"
                        Grid.Row="{Binding RedoRow}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="13"
                        Padding="4,0"
                        Command="{Binding RedoCommand}"
                        IsEnabled="{Binding CanRedo}"
                        Text="{Binding RedoText}" />

                <Button Grid.Column="{Binding HintColumn}"
                        Grid.Row="{Binding HintRow}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="13"
                        Padding="4,0"
                        Command="{Binding UseHintCommand}"
                        IsEnabled="{Binding CanUseHint}"
                        Text="{Binding HintText}" />

                <Button Grid.Column="{Binding RestartColumn}"
                        Grid.Row="{Binding RestartRow}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="13"
                        Padding="4,0"
                        Command="{Binding RestartCommand}"
                        Text="{Binding RestartText}" />
            </Grid>

            <!--
              Mode toggle is the widest, lowest button. It is also available with hold-to-cross
              when a screen reader is active: accessible cell buttons activate the selected mark
              without the canvas's long-press gesture. See ShowModeButton.
            -->
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding ToggleModeCommand}"
                    HeightRequest="56"
                    IsVisible="{Binding ShowModeButton}"
                    Text="{Binding ModeButtonText}" />
        </VerticalStackLayout>
    </Grid>

        <!--
          Pause is an overlay so the session stays in memory while its save completes.
          Each modal scrolls when content exceeds the viewport. The inner grid keeps shorter
          cards centred; minimum button heights allow system text scaling to expand them.
        -->
        <Grid IsVisible="{Binding IsPaused}" BackgroundColor="#CC000000">
            <ScrollView x:Name="IsPausedScroll" Margin="16">
                <Grid MinimumHeightRequest="{Binding Height, Source={x:Reference IsPausedScroll}, x:DataType=ScrollView}">
                    <Border Style="{StaticResource Card}"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill"
                            MaximumWidthRequest="300"
                            Padding="24">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <controls:MascotView Grid.Row="0" Pose="Think" HeightRequest="80" WidthRequest="74" HorizontalOptions="Center"
                                                 AutomationProperties.ExcludedWithChildren="True" />
                            <Label Grid.Row="1" Text="{Binding PausedTitle}" Style="{StaticResource H1}" HorizontalTextAlignment="Center"
                                   SemanticProperties.HeadingLevel="Level1" />

                            <Button Grid.Row="2" Text="{Binding ResumeText}"
                                    Command="{Binding ResumeCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinimumHeightRequest="54" />
                            <Button Grid.Row="3" Text="{Binding RestartText}"
                                    Command="{Binding RestartCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinimumHeightRequest="50" />
                            <Button Grid.Row="4" Text="{Binding HowToText}"
                                    Command="{Binding HowToCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinimumHeightRequest="50" />
                            <Button Grid.Row="5" Text="{Binding OptionsText}"
                                    Command="{Binding OptionsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinimumHeightRequest="50" />
                            <Button Grid.Row="6" Text="{Binding QuitText}"
                                    Command="{Binding QuitCommand}"
                                    BackgroundColor="{DynamicResource WarnSoft}"
                                    TextColor="{DynamicResource OnWarnSoft}"
                                    CornerRadius="16"
                                    FontFamily="BodyBold"
                                    MinimumHeightRequest="50" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollView>
        </Grid>

        <!--
          Break reminder. Sits above the board and below the win overlay, so finishing the
          picture on the very tick the limit is reached still shows the celebration.
        -->
        <Grid IsVisible="{Binding IsBreakReminderOpen}" BackgroundColor="#CC000000">
            <ScrollView x:Name="IsBreakReminderOpenScroll" Margin="16">
                <Grid MinimumHeightRequest="{Binding Height, Source={x:Reference IsBreakReminderOpenScroll}, x:DataType=ScrollView}">
                    <Border Style="{StaticResource Card}"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill"
                            MaximumWidthRequest="310"
                            Padding="24">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                            <controls:MascotView Grid.Row="0" Pose="Idle" HeightRequest="80" WidthRequest="74" HorizontalOptions="Center"
                                                 AutomationProperties.ExcludedWithChildren="True" />

                            <Label Grid.Row="1" Text="{Binding BreakTitle}" Style="{StaticResource H2}" HorizontalTextAlignment="Center"
                                   SemanticProperties.HeadingLevel="Level1" />

                            <!-- Explicit size: see the note on HowToPage about wrapped labels in cards. -->
                            <Label Grid.Row="2" Text="{Binding BreakBody}"
                                   Style="{StaticResource Subtle}"
                                   FontSize="15"
                                   HorizontalTextAlignment="Center" />

                            <Button Grid.Row="3" Text="{Binding BreakKeepText}"
                                    Command="{Binding DismissBreakReminderCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinimumHeightRequest="54" />
                            <Button Grid.Row="4" Text="{Binding BreakStopText}"
                                    Command="{Binding QuitCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinimumHeightRequest="50" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollView>
        </Grid>

        <!--
          Out of time. The game's only loss, so it is worded as a setback rather than a failure and
          leads with another go - the same shape as the win overlay, deliberately.
        -->
        <Grid IsVisible="{Binding IsTimeUp}" BackgroundColor="#E6000000">
            <ScrollView x:Name="IsTimeUpScroll" Margin="16">
                <Grid MinimumHeightRequest="{Binding Height, Source={x:Reference IsTimeUpScroll}, x:DataType=ScrollView}">
                    <Border Style="{StaticResource Card}"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill"
                            MaximumWidthRequest="310"
                            Padding="24">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                            <controls:MascotView Grid.Row="0" Pose="Think" HeightRequest="80" WidthRequest="74" HorizontalOptions="Center"
                                                 AutomationProperties.ExcludedWithChildren="True" />

                            <Label Grid.Row="1" Text="{Binding TimeUpTitle}" Style="{StaticResource H1}" HorizontalTextAlignment="Center"
                                   SemanticProperties.HeadingLevel="Level1" />

                            <!-- Explicit size: see the note on HowToPage about wrapped labels in cards. -->
                            <Label Grid.Row="2" Text="{Binding TimeUpBody}"
                                   Style="{StaticResource Subtle}"
                                   FontSize="15"
                                   HorizontalTextAlignment="Center" />

                            <Button Grid.Row="3" Text="{Binding TryAgainText}"
                                    Command="{Binding RestartCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinimumHeightRequest="54" />
                            <Button Grid.Row="4" Text="{Binding MenuText}"
                                    Command="{Binding QuitCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinimumHeightRequest="50" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollView>
        </Grid>

        <!-- Win overlay: the picture revealed in its own colour, plus the result. -->
        <Grid IsVisible="{Binding IsSolved}" BackgroundColor="#E6000000">
            <!-- Falls behind the card, over the dimmed board. Purely decorative. -->
            <controls:ConfettiView IsRunning="{Binding IsSolved}"
                                   AutomationProperties.ExcludedWithChildren="True" />
            <ScrollView x:Name="IsSolvedScroll" Margin="16">
                <Grid MinimumHeightRequest="{Binding Height, Source={x:Reference IsSolvedScroll}, x:DataType=ScrollView}">
                    <Border Style="{StaticResource Card}"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill"
                            MaximumWidthRequest="320"
                            Padding="24">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                            <controls:MascotView Grid.Row="0" Pose="Cheer" HeightRequest="80" WidthRequest="74" HorizontalOptions="Center"
                                                 AutomationProperties.ExcludedWithChildren="True" />

                            <Label Grid.Row="1" Text="{Binding SolvedTitle}" Style="{StaticResource H1}" HorizontalTextAlignment="Center"
                                   SemanticProperties.HeadingLevel="Level1" />

                            <!-- The picture is announced by name in the win message instead. -->
                            <controls:PuzzleArtView Grid.Row="2" x:Name="Reveal"
                                                    AutomationProperties.ExcludedWithChildren="True"
                                                    HeightRequest="200"
                                                    HorizontalOptions="Center"
                                                    WidthRequest="200" />

                            <Label Grid.Row="3" Text="{Binding StarsText}"
                                   SemanticProperties.Description="{Binding StarsDescription}"
                                   FontSize="30"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{DynamicResource Gold}" />

                            <!-- The design's result tiles: how long, how much help, how many slips. -->
                            <Grid Grid.Row="4" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border Grid.Column="0" BackgroundColor="{DynamicResource Surface2}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="6,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding SolvedTimeText}" FontFamily="BodyBold" FontSize="18"
                                               TextColor="{DynamicResource Ink}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding TimeLabel}" Style="{StaticResource Subtle}" FontSize="13"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="{DynamicResource Surface2}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="6,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding HintsUsed}" FontFamily="BodyBold" FontSize="18"
                                               TextColor="{DynamicResource Ink}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding HintsLabel}" Style="{StaticResource Subtle}" FontSize="13"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" BackgroundColor="{DynamicResource Surface2}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="6,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Mistakes}" FontFamily="BodyBold" FontSize="18"
                                               TextColor="{DynamicResource Ink}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding MistakesLabel}" Style="{StaticResource Subtle}" FontSize="13"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- The last level has no "next": the button gives way to a farewell line. -->
                            <Label Grid.Row="5" Text="{Binding AllLevelsDoneText}"
                                   IsVisible="{Binding IsCampaignComplete}"
                                   Style="{StaticResource Subtle}"
                                   FontFamily="BodyBold"
                                   TextColor="{DynamicResource AccentDeep}"
                                   HorizontalTextAlignment="Center" />

                            <Button Grid.Row="6" Text="{Binding NextPuzzleText}"
                                    Command="{Binding NextPuzzleCommand}"
                                    IsVisible="{Binding ShowNextButton}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinimumHeightRequest="54" />
                            <Button Grid.Row="7" Text="{Binding MenuText}"
                                    Command="{Binding QuitCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinimumHeightRequest="50" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollView>
        </Grid>
        </Grid>
    </Grid>

</ContentPage>
