<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Squarebuzz.App.ViewModels"
             xmlns:controls="clr-namespace:Squarebuzz.App.Controls"
             x:Class="Squarebuzz.App.Views.GamePage"
             x:DataType="vm:GameViewModel"
             BackgroundColor="{DynamicResource Bg}">

    <!-- Outer grid layers the pause and win overlays over the board. -->
    <Grid>
    <Grid RowDefinitions="Auto,*,Auto"
          Padding="{StaticResource PagePadding}"
          RowSpacing="12">

        <!-- Status bar: picture name, counters, timer, pause -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding PuzzleName}" Style="{StaticResource H2}" />
                <Label Text="{Binding StatusText}" Style="{StaticResource Subtle}" FontSize="14" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="⏸"
                    Command="{Binding PauseCommand}"
                    BackgroundColor="{DynamicResource Surface2}"
                    TextColor="{DynamicResource Ink}"
                    CornerRadius="999"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    VerticalOptions="Center" />

            <Border Grid.Column="2"
                    IsVisible="{Binding ShowTimer}"
                    BackgroundColor="{DynamicResource Surface2}"
                    Stroke="{DynamicResource Line}"
                    StrokeThickness="2"
                    Padding="14,8"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="999" />
                </Border.StrokeShape>
                <Label Text="{Binding ElapsedText}" FontAttributes="Bold" FontSize="18" />
            </Border>
        </Grid>

        <!-- The board. Scrollable on both axes so a 25x25 grid stays reachable on a phone. -->
        <!--
          The host fills the row, so its measured size IS the space available to the board.
          The board then centres itself inside it, and the host scrolls only when the board
          is genuinely larger.
        -->
        <ScrollView Grid.Row="1"
                    x:Name="BoardHost"
                    Orientation="Both"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
            <controls:BoardView x:Name="Board"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Session="{Binding Session}"
                                ZoomPercent="{Binding ZoomPercent}"
                                BigNumbers="{Binding BigNumbers}"
                                TapBehaviour="{Binding TapBehaviour}" />
        </ScrollView>

        <!-- Controls -->
        <VerticalStackLayout Grid.Row="2" Spacing="10">

            <Label Text="{Binding Toast}"
                   IsVisible="{Binding HasToast}"
                   Style="{StaticResource Subtle}"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource PrimaryDeep}" />

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="13"
                        Padding="4,0"
                        Command="{Binding UndoCommand}"
                        IsEnabled="{Binding CanUndo}"
                        Text="{Binding UndoText}" />

                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="13"
                        Padding="4,0"
                        Command="{Binding RedoCommand}"
                        IsEnabled="{Binding CanRedo}"
                        Text="{Binding RedoText}" />

                <Button Grid.Column="2"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="13"
                        Padding="4,0"
                        Command="{Binding UseHintCommand}"
                        Text="{Binding HintText}" />

                <Button Grid.Column="3"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="13"
                        Padding="4,0"
                        Command="{Binding RestartCommand}"
                        Text="{Binding RestartText}" />
            </Grid>

            <!-- Mode toggle is the widest, lowest button: it is the control used most often. -->
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding ToggleModeCommand}"
                    HeightRequest="56"
                    Text="{Binding ModeButtonText}" />
        </VerticalStackLayout>
    </Grid>

        <!--
          Pause overlay. An overlay rather than a route so the session stays in memory - pausing
          must never risk the board, and there is nothing to serialise.
        -->
        <Grid IsVisible="{Binding IsPaused}" BackgroundColor="#CC000000">
            <Border Style="{StaticResource Card}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    WidthRequest="300"
                    Padding="24">
                <VerticalStackLayout Spacing="12">
                    <controls:MascotView Pose="Think" HeightRequest="80" WidthRequest="74" HorizontalOptions="Center" />
                    <Label Text="{Binding PausedTitle}" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />

                    <Button Text="{Binding ResumeText}"
                            Command="{Binding ResumeCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="54" />
                    <Button Text="{Binding RestartText}"
                            Command="{Binding RestartCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="50" />
                    <Button Text="{Binding HowToText}"
                            Command="{Binding HowToCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="50" />
                    <Button Text="{Binding QuitText}"
                            Command="{Binding QuitCommand}"
                            BackgroundColor="{DynamicResource WarnSoft}"
                            TextColor="{DynamicResource OnWarnSoft}"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            HeightRequest="50" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Win overlay: the picture revealed in its own colour, plus the result. -->
        <Grid IsVisible="{Binding IsSolved}" BackgroundColor="#E6000000">
            <Border Style="{StaticResource Card}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    WidthRequest="320"
                    Padding="24">
                <VerticalStackLayout Spacing="14">
                    <controls:MascotView Pose="Cheer" HeightRequest="80" WidthRequest="74" HorizontalOptions="Center" />

                    <Label Text="{Binding SolvedTitle}" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />

                    <controls:PuzzleArtView x:Name="Reveal"
                                            HeightRequest="200"
                                            HorizontalOptions="Center"
                                            WidthRequest="200" />

                    <Label Text="{Binding StarsText}"
                           FontSize="30"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource Gold}" />

                    <Label Style="{StaticResource Subtle}" HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding TimeLabel}" />
                                <Span Text=" " />
                                <Span Text="{Binding ElapsedText}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Button Text="{Binding NextPuzzleText}"
                            Command="{Binding NextPuzzleCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="54" />
                    <Button Text="{Binding MenuText}"
                            Command="{Binding QuitCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="50" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
