<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Squarebuzz.Presentation.ViewModels;assembly=Squarebuzz.Presentation"
             xmlns:conv="clr-namespace:Squarebuzz.App.Converters"
             x:Class="Squarebuzz.App.Views.LevelsPage"
             x:DataType="vm:LevelsViewModel"
             BackgroundColor="{DynamicResource Bg}">

    <ContentPage.Resources>
        <conv:LevelStateSelectConverter x:Key="NodeFill"
                                        DoneValue="{StaticResource Accent}"
                                        CurrentValue="{StaticResource Primary}"
                                        LockedValue="{StaticResource Surface}" />
        <conv:LevelStateSelectConverter x:Key="NodeStroke"
                                        DoneValue="{StaticResource AccentDeep}"
                                        CurrentValue="{StaticResource PrimaryDeep}"
                                        LockedValue="{StaticResource Line}" />
        <conv:LevelStateSelectConverter x:Key="NodeInk"
                                        DoneValue="{StaticResource OnAccent}"
                                        CurrentValue="{StaticResource OnPrimary}"
                                        LockedValue="{StaticResource Ink2}" />
        <conv:LevelStateSelectConverter x:Key="TrailInk"
                                        DoneValue="{StaticResource Accent}"
                                        CurrentValue="{StaticResource Line}"
                                        LockedValue="{StaticResource Line}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="{StaticResource PagePadding}" RowSpacing="12">

        <Label Grid.Row="0" Text="{Binding Heading}" Style="{StaticResource H1}"
               SemanticProperties.HeadingLevel="Level1" />

        <Label Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource Subtle}" />

        <!--
          The whole campaign as one grouped, virtualizing list. The old Puzzle Path drew its
          twelve stops with BindableLayout; six hundred would build six hundred views up front,
          so this must be a CollectionView.
        -->
        <CollectionView Grid.Row="2"
                        x:Name="LevelList"
                        ItemsSource="{Binding Groups}"
                        IsGrouped="True"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:LevelGroup">
                    <Label Text="{Binding Title}"
                           Style="{StaticResource Subtle}"
                           FontFamily="BodyBold"
                           Margin="0,14,0,8"
                           HorizontalTextAlignment="Center" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LevelCard">
                    <VerticalStackLayout Spacing="0" TranslationX="{Binding Offset}">
                        <Grid HorizontalOptions="Center">
                            <Border SemanticProperties.Description="{Binding Description}"
                                    BackgroundColor="{Binding State, Converter={StaticResource NodeFill}}"
                                    Stroke="{Binding State, Converter={StaticResource NodeStroke}}"
                                    StrokeThickness="3"
                                    WidthRequest="{Binding Diameter}"
                                    HeightRequest="{Binding Diameter}"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Path=PlayLevelCommand, Source={RelativeSource AncestorType={x:Type vm:LevelsViewModel}}, x:DataType=vm:LevelsViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Label Text="{Binding Caption}"
                                       FontFamily="Display"
                                       FontSize="{Binding FontSize}"
                                       TextColor="{Binding State, Converter={StaticResource NodeInk}}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>

                            <!-- A picture hides at this level. Decorative - the description says it in words. -->
                            <Label Text="🖼"
                                   IsVisible="{Binding IsMilestone}"
                                   FontSize="14"
                                   Margin="0,-4,-30,0"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Start"
                                   TranslationX="22"
                                   InputTransparent="True"
                                   AutomationProperties.ExcludedWithChildren="True" />
                        </Grid>

                        <!-- Three dots joining this stop to the next. Not after the last. -->
                        <VerticalStackLayout Spacing="4"
                                             Margin="0,4"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding IsLast, Converter={StaticResource InvertBool}}">
                            <BoxView WidthRequest="5" HeightRequest="5" CornerRadius="3"
                                     Color="{Binding State, Converter={StaticResource TrailInk}}" />
                            <BoxView WidthRequest="5" HeightRequest="5" CornerRadius="3"
                                     Color="{Binding State, Converter={StaticResource TrailInk}}" />
                            <BoxView WidthRequest="5" HeightRequest="5" CornerRadius="3"
                                     Color="{Binding State, Converter={StaticResource TrailInk}}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
