<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Squarebuzz.App.ViewModels"
             xmlns:controls="clr-namespace:Squarebuzz.App.Controls"
             x:Class="Squarebuzz.App.Views.ComingSoonPage"
             x:DataType="vm:ComingSoonViewModel"
             Shell.NavBarIsVisible="True"
             Title="{Binding Heading}"
             BackgroundColor="{DynamicResource Bg}">

    <VerticalStackLayout VerticalOptions="Center"
                         Spacing="20"
                         Padding="{StaticResource PagePadding}"
                         MaximumWidthRequest="{StaticResource FrameMaxWidth}"
                         HorizontalOptions="Center">

        <controls:MascotView Pose="Think" HeightRequest="110" WidthRequest="102" HorizontalOptions="Center" />

        <Label Text="{Binding Heading}" Style="{StaticResource H1}" HorizontalTextAlignment="Center" />

        <Label Style="{StaticResource Subtle}"
               HorizontalTextAlignment="Center"
               Text="This screen is next on the list." />

        <Button Text="{Binding BackLabel}"
                Command="{Binding BackCommand}"
                Style="{StaticResource SecondaryButton}"
                HeightRequest="56" />
    </VerticalStackLayout>

</ContentPage>
