<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Squarebuzz.Presentation.ViewModels;assembly=Squarebuzz.Presentation"
             xmlns:controls="clr-namespace:Squarebuzz.App.Controls"
             xmlns:conv="clr-namespace:Squarebuzz.App.Converters"
             x:Class="Squarebuzz.App.Views.OptionsPage"
             x:DataType="vm:OptionsViewModel"
             Title="{Binding Heading}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource Bg}">

    <ContentPage.Resources>
        <!-- Theme colours by key: the converter looks them up on every conversion. See BoolSelectConverter. -->
        <conv:BoolSelectConverter x:Key="SegBackground"
                                  TrueKey="Primary"
                                  FalseKey="Surface2" />
        <conv:BoolSelectConverter x:Key="SegTextColor"
                                  TrueKey="OnPrimary"
                                  FalseKey="Ink" />

        <Style x:Key="SectionHeading" TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource Ink2}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="BodyBold" />
            <Setter Property="Margin" Value="4,10,0,0" />
        </Style>

        <Style x:Key="RowLabel" TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource Ink}" />
            <Setter Property="FontFamily" Value="BodyBold" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <!-- Denser than the shared segment: up to four sit in a row on a phone. -->
        <Style x:Key="SegButton" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" SafeAreaEdges="All">
        <Border Grid.Row="0" IsVisible="{Binding HasPersistenceFailure}"
                BackgroundColor="{DynamicResource Surface2}" Stroke="{DynamicResource Line}"
                Padding="12,8">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding PersistenceFailureText}" TextColor="{DynamicResource Ink}"
                       SemanticProperties.HeadingLevel="Level2" />
                <Button Text="{Binding RetryPersistenceText}" Command="{Binding RetryPersistenceCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>
        </Border>
        <Grid Grid.Row="1">
        <ScrollView IsEnabled="{Binding CanEditSettings}"
                    AutomationProperties.ExcludedWithChildren="{Binding HasOptionsOverlay}">
            <VerticalStackLayout Padding="{StaticResource PagePadding}"
                                 Spacing="6"
                                 MaximumWidthRequest="{StaticResource FrameMaxWidth}"
                                 HorizontalOptions="Center">

                <!-- Audio -->
                <Label Text="{Binding AudioSection}" Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource Card}" Padding="16,6">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
                            <Label Text="{Binding SoundLabel}" Style="{StaticResource RowLabel}" />
                            <Switch Grid.Column="1" IsToggled="{Binding SoundEffects}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
                            <Label Text="{Binding MusicLabel}" Style="{StaticResource RowLabel}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Music}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding VoiceLabel}" Style="{StaticResource RowLabel}" />
                                <!-- Only appears when the device has no voice for this language. -->
                                <Label Text="{Binding NoVoiceNote}"
                                       IsVisible="{Binding HasNoVoice}"
                                       Style="{StaticResource Subtle}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding VoiceNarration}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
                            <Label Text="{Binding HapticsLabel}" Style="{StaticResource RowLabel}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Haptics}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Look and feel -->
                <Label Text="{Binding LookSection}" Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <VerticalStackLayout Spacing="14">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Text="{Binding ThemeLabel}" Style="{StaticResource RowLabel}" />
                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Style="{StaticResource SegButton}"
                                        Text="{Binding LightLabel}"
                                        Command="{Binding SelectThemeCommand}" CommandParameter="light"
                                        BackgroundColor="{Binding IsLightTheme, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsLightTheme, Converter={StaticResource SegTextColor}}" />
                                <Button Grid.Column="1" Style="{StaticResource SegButton}"
                                        Text="{Binding DarkLabel}"
                                        Command="{Binding SelectThemeCommand}" CommandParameter="dark"
                                        BackgroundColor="{Binding IsDarkTheme, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsDarkTheme, Converter={StaticResource SegTextColor}}" />
                                <!-- Auto takes light/dark from the phone. See ThemeService.Resolve. -->
                                <Button Grid.Column="2" Style="{StaticResource SegButton}"
                                        Text="{Binding AutoLabel}"
                                        Command="{Binding SelectThemeCommand}" CommandParameter="auto"
                                        BackgroundColor="{Binding IsAutoTheme, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsAutoTheme, Converter={StaticResource SegTextColor}}" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding ColorBlindLabel}" Style="{StaticResource RowLabel}" />
                                <Label Text="{Binding ColorBlindNote}" Style="{StaticResource Subtle}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding ColorBlindEnabled}" />
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Text="{Binding AccentLabel}" Style="{StaticResource RowLabel}" />
                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Style="{StaticResource SegButton}"
                                        Text="{Binding TangerineLabel}"
                                        Command="{Binding SelectAccentCommand}" CommandParameter="tangerine"
                                        BackgroundColor="{Binding IsTangerine, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsTangerine, Converter={StaticResource SegTextColor}}" />
                                <Button Grid.Column="1" Style="{StaticResource SegButton}"
                                        Text="{Binding GrapeLabel}"
                                        Command="{Binding SelectAccentCommand}" CommandParameter="grape"
                                        BackgroundColor="{Binding IsGrape, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsGrape, Converter={StaticResource SegTextColor}}" />
                                <Button Grid.Column="2" Style="{StaticResource SegButton}"
                                        Text="{Binding TrioLabel}"
                                        Command="{Binding SelectAccentCommand}" CommandParameter="trio"
                                        BackgroundColor="{Binding IsTrio, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsTrio, Converter={StaticResource SegTextColor}}" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
                            <Label Text="{Binding BigNumbersLabel}" Style="{StaticResource RowLabel}" />
                            <Switch Grid.Column="1" IsToggled="{Binding BigNumbers}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Controls -->
                <Label Text="{Binding ControlsSection}" Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <VerticalStackLayout Spacing="14">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Text="{Binding TapBehaviourLabel}" Style="{StaticResource RowLabel}" />
                            <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                                <Button Grid.Row="0" Style="{StaticResource SegButton}"
                                        Text="{Binding ModeLabel}"
                                        Command="{Binding SelectTapBehaviourCommand}" CommandParameter="mode"
                                        BackgroundColor="{Binding IsModeButton, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsModeButton, Converter={StaticResource SegTextColor}}" />
                                <Button Grid.Row="1" Style="{StaticResource SegButton}"
                                        Text="{Binding HoldLabel}"
                                        Command="{Binding SelectTapBehaviourCommand}" CommandParameter="hold"
                                        BackgroundColor="{Binding IsHoldToCross, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsHoldToCross, Converter={StaticResource SegTextColor}}" />
                            </Grid>
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Text="{Binding HandedLabel}" Style="{StaticResource RowLabel}" />
                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Style="{StaticResource SegButton}"
                                        Text="{Binding LeftLabel}"
                                        Command="{Binding SelectHandednessCommand}" CommandParameter="left"
                                        BackgroundColor="{Binding IsLeftHanded, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsLeftHanded, Converter={StaticResource SegTextColor}}" />
                                <Button Grid.Column="1" Style="{StaticResource SegButton}"
                                        Text="{Binding RightLabel}"
                                        Command="{Binding SelectHandednessCommand}" CommandParameter="right"
                                        BackgroundColor="{Binding IsRightHanded, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsRightHanded, Converter={StaticResource SegTextColor}}" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" MinimumHeightRequest="56" ColumnSpacing="8">
                            <Label Text="{Binding CellSizeLabel}" Style="{StaticResource RowLabel}" />
                            <Button Grid.Column="1" Text="−" Command="{Binding ZoomOutCommand}"
                                    SemanticProperties.Description="{Binding SmallerLabel}"
                                    Style="{StaticResource SegButton}" WidthRequest="52"
                                    BackgroundColor="{DynamicResource Surface2}" TextColor="{DynamicResource Ink}" />
                            <Label Grid.Column="2" Text="{Binding CellZoomText}" Style="{StaticResource RowLabel}"
                                   WidthRequest="56" HorizontalTextAlignment="Center" />
                            <Button Grid.Column="3" Text="+" Command="{Binding ZoomInCommand}"
                                    SemanticProperties.Description="{Binding BiggerLabel}"
                                    Style="{StaticResource SegButton}" WidthRequest="52"
                                    BackgroundColor="{DynamicResource Surface2}" TextColor="{DynamicResource Ink}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding MagnifierLabel}" Style="{StaticResource RowLabel}" />
                                <Label Text="{Binding MagnifierNote}" Style="{StaticResource Subtle}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding ShowMagnifier}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Helpers -->
                <Label Text="{Binding HelpersSection}" Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource Card}" Padding="16,6">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
                            <Label Text="{Binding AutoCrossLabel}" Style="{StaticResource RowLabel}" />
                            <Switch Grid.Column="1" IsToggled="{Binding AutoCross}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
                            <Label Text="{Binding WarnLabel}" Style="{StaticResource RowLabel}" />
                            <Switch Grid.Column="1" IsToggled="{Binding WarnOnMistakes}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
                            <Label Text="{Binding TimerLabel}" Style="{StaticResource RowLabel}" />
                            <Switch Grid.Column="1" IsToggled="{Binding ShowTimer}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56">
                            <Label Text="{Binding HintsLabel}" Style="{StaticResource RowLabel}" />
                            <Switch Grid.Column="1" IsToggled="{Binding AllowHints}" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding AllowHints}" Spacing="8" Margin="0,4,0,10">
                            <Label Text="{Binding HintLimitLabel}" Style="{StaticResource RowLabel}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="56">
                                <Label Text="{Binding UnlimitedHintsLabel}" Style="{StaticResource RowLabel}" />
                                <Switch Grid.Column="1" IsToggled="{Binding UnlimitedHints}" />
                            </Grid>
                            <Entry Text="{Binding HintLimitText}" Keyboard="Numeric"
                                   IsEnabled="{Binding CanEditHintLimit}"
                                   SemanticProperties.Description="{Binding HintLimitLabel}"
                                   FontFamily="BodyBold" TextColor="{DynamicResource Ink}"
                                   MinimumHeightRequest="56" />
                            <Label Text="{Binding HintLimitError}" IsVisible="{Binding HasHintLimitError}"
                                   TextColor="{DynamicResource OnWarnSoft}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Language -->
                <Label Text="{Binding LanguageSection}" Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <!-- Use the native picker for the supported language list. -->
                    <Picker ItemsSource="{Binding Languages}"
                            ItemDisplayBinding="{Binding Endonym, x:DataType=vm:LanguageOption}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                            Title="{Binding LanguageSection}"
                            FontFamily="BodyBold"
                            FontSize="16"
                            TextColor="{DynamicResource Ink}"
                            TitleColor="{DynamicResource Ink2}"
                            MinimumHeightRequest="{StaticResource TouchTargetMin}" />
                </Border>

                <!-- Parent zone -->
                <Label Text="{Binding ParentSection}" Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <VerticalStackLayout Spacing="14">
                        <!--
                          Screen-time reminder. Ungated: the sum in front of Reset is there to
                          stop a child wiping their own progress, and a break reminder is not
                          destructive - gating it would only get in a parent's way.
                        -->
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Text="{Binding ScreenTimeLabel}" Style="{StaticResource RowLabel}" />
                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Style="{StaticResource SegButton}"
                                        Text="{Binding ScreenTimeOffLabel}"
                                        Command="{Binding SelectScreenTimeCommand}" CommandParameter="off"
                                        BackgroundColor="{Binding IsScreenTimeOff, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsScreenTimeOff, Converter={StaticResource SegTextColor}}" />
                                <Button Grid.Column="1" Style="{StaticResource SegButton}"
                                        Text="{Binding ScreenTime15Label}"
                                        Command="{Binding SelectScreenTimeCommand}" CommandParameter="15"
                                        BackgroundColor="{Binding IsScreenTime15, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsScreenTime15, Converter={StaticResource SegTextColor}}" />
                                <Button Grid.Column="2" Style="{StaticResource SegButton}"
                                        Text="{Binding ScreenTime30Label}"
                                        Command="{Binding SelectScreenTimeCommand}" CommandParameter="30"
                                        BackgroundColor="{Binding IsScreenTime30, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsScreenTime30, Converter={StaticResource SegTextColor}}" />
                                <Button Grid.Column="3" Style="{StaticResource SegButton}"
                                        Text="{Binding ScreenTime60Label}"
                                        Command="{Binding SelectScreenTimeCommand}" CommandParameter="60"
                                        BackgroundColor="{Binding IsScreenTime60, Converter={StaticResource SegBackground}}"
                                        TextColor="{Binding IsScreenTime60, Converter={StaticResource SegTextColor}}" />
                            </Grid>
                        </Grid>

                        <Label Text="{Binding Gate.Title}" Style="{StaticResource Subtle}" FontSize="12" />

                        <!-- Data & privacy, behind the same gate as everything grown-up. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource RowLabel}"
                                   Text="{Binding PrivacyLabel}" />
                            <Button Grid.Column="1"
                                    Text="{Binding PrivacyOpenLabel}"
                                    Command="{Binding PrivacyCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HeightRequest="48"
                                    MinimumWidthRequest="96" />
                        </Grid>

                        <Label Text="{Binding Notice}"
                               IsVisible="{Binding HasNotice}"
                               Style="{StaticResource Subtle}"
                               FontFamily="BodyBold"
                               HorizontalTextAlignment="Center" />

                        <Button Text="{Binding ResetLabel}"
                                Command="{Binding OpenResetGateCommand}"
                                Style="{StaticResource WarnButton}"
                                HeightRequest="52" />
                        <Label Text="{Binding VersionLabel}" Style="{StaticResource Subtle}" FontSize="12" />
                        <Label Text="{Binding NoAdsLabel}" Style="{StaticResource Subtle}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Parent gate: a small sum before anything destructive. -->
        <controls:ParentGateOverlay BindingContext="{Binding Gate}" />

        <!-- Reset confirmation, once past the gate. -->
        <controls:ModalCard IsVisible="{Binding IsResetConfirmOpen}" DimColor="#E6000000" CardMaxWidth="310">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                <Label Grid.Row="0" Text="{Binding ResetTitle}" Style="{StaticResource H2}" HorizontalTextAlignment="Center" />
                <Label Grid.Row="1" Text="{Binding ResetBody}" Style="{StaticResource Subtle}" HorizontalTextAlignment="Center" />

                <Button Grid.Row="2" Text="{Binding ResetConfirm}"
                        Command="{Binding ConfirmResetCommand}"
                        Style="{StaticResource WarnButton}"
                        BackgroundColor="{DynamicResource Warn}"
                        TextColor="{DynamicResource OnWarn}"
                        MinimumHeightRequest="52" />
                <Button Grid.Row="3" Text="{Binding CancelLabel}" Command="{Binding CancelResetCommand}"
                        Style="{StaticResource SecondaryButton}" MinimumHeightRequest="48" />
            </Grid>
        </controls:ModalCard>
        </Grid>
    </Grid>

</ContentPage>
