<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Squarebuzz.App.Views"
       x:Class="Squarebuzz.App.AppShell"
       FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{DynamicResource Bg}"
       Shell.ForegroundColor="{DynamicResource Ink}"
       Shell.TitleColor="{DynamicResource Ink}"
       Shell.NavBarIsVisible="False">

    <!--
      The game drives its own full-screen navigation, so Shell chrome stays hidden by default
      and secondary pages opt back in for a visible back button. Splash, Onboarding and Menu
      are declared as ShellContent so
      ResetToAsync("//route") can replace the stack; everything else is a pushed route
      registered in AppShell.xaml.cs.
    -->
    <ShellContent Route="splash"
                  ContentTemplate="{DataTemplate views:SplashPage}" />

    <ShellContent Route="onboarding"
                  ContentTemplate="{DataTemplate views:OnboardingPage}" />

    <ShellContent Route="menu"
                  ContentTemplate="{DataTemplate views:MenuPage}" />

</Shell>
