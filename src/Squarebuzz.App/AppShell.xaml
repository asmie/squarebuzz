<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Squarebuzz.App.Views"
       x:Class="Squarebuzz.App.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False">

    <!--
      The game drives its own full-screen navigation, so the Shell chrome stays hidden.
      Routes for the individual screens are registered in AppShell.xaml.cs as each screen
      is built; this ShellContent is the entry point.
    -->
    <ShellContent Route="startup"
                  ContentTemplate="{DataTemplate views:StartupPage}" />

</Shell>
