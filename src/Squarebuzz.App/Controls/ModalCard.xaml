<?xml version="1.0" encoding="UTF-8" ?>
<!--
  The shell every modal shares: a dimmed backdrop over the page, and a centred card on it.
  The card scrolls when its content exceeds the viewport; the inner grid is held at least as
  tall as the scroll viewport so shorter cards stay centred instead of sticking to the top.
  Minimum (not fixed) button heights inside the cards let system text scaling expand them.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Squarebuzz.App.Controls"
             x:Class="Squarebuzz.App.Controls.ModalCard">

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="{Binding DimColor, Source={RelativeSource TemplatedParent}, x:DataType=controls:ModalCard}">
                <ScrollView x:Name="CardScroll" Margin="16">
                    <Grid MinimumHeightRequest="{Binding Height, Source={x:Reference CardScroll}, x:DataType=ScrollView}">
                        <Border Style="{StaticResource Card}"
                                VerticalOptions="Center"
                                HorizontalOptions="Fill"
                                MaximumWidthRequest="{Binding CardMaxWidth, Source={RelativeSource TemplatedParent}, x:DataType=controls:ModalCard}"
                                Padding="24">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ScrollView>
            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
