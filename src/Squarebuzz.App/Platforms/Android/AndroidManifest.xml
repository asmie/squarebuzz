<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    No INTERNET permission on purpose. squarebuzz is a fully offline game for children aged
    6 and up and adults, with no upper age limit. It has no ads, analytics or purchases.
    The absence of this permission is the strongest guarantee of that.
    Add it only if a real online feature ever ships.
  -->
  <uses-permission android:name="android.permission.VIBRATE" />

  <!--
    Android 11+ hides other apps unless asked for: without this the grown-ups' privacy link
    finds no browser to open. Opening a page in the browser needs no INTERNET permission here.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
    <intent>
      <action android:name="android.support.customtabs.action.CustomTabsService" />
    </intent>
  </queries>

  <!-- Phones and tablets, both orientations. -->
  <supports-screens
      android:smallScreens="true"
      android:normalScreens="true"
      android:largeScreens="true"
      android:xlargeScreens="true"
      android:anyDensity="true" />

  <application
      android:allowBackup="true"
      android:icon="@mipmap/appicon"
      android:roundIcon="@mipmap/appicon_round"
      android:supportsRtl="true" />

</manifest>
